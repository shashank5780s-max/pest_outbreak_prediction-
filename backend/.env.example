# AgriPredict Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → Project → Settings → API
PROJECT_URL=https://<your-project-ref>.supabase.co
API_KEY=<your-supabase-anon-key>

# ── OpenWeatherMap ────────────────────────────────────────────────────────────
# Get from: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=<your-openweathermap-key>

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
# Used for /chat (GPT-3.5) and /analyze-leaf (GPT-4o Vision).
# If absent, both endpoints return clearly labeled demo/fallback responses.
OPENAI_API_KEY=<your-openai-key>

# ── Default coordinates (Karnataka centroid) ──────────────────────────────────
KARNATAKA_LAT=15.3173
KARNATAKA_LNG=75.7139

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origins — comma-separated if multiple (e.g. staging + prod).
# DO NOT use * in production. Example value below allows local development.
FRONTEND_ORIGINS=http://localhost:3000
